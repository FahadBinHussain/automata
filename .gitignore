# Root-level ignores (safe defaults)

# OS/editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.tmp
*.log

# Env and local config
.env
.env.*
*.local
**/.env.local
youtube.com/youtube.com-stream-watch-codex-automation.config.json

# Build artifacts (embeds machine build paths - rebuild from source)
socks5-proxy/*.exe
window-capture/*.exe

# Dependency folders
**/node_modules/
**/.pnpm-store/

# Python caches/venvs
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc

# Build/cache outputs
**/dist/
**/build/
**/.cache/
**/.next/
**/.nuxt/
**/coverage/

# IDE folders
.vscode/
.idea/
last-sync-content.txt
agent-rules-sync.log

# tool build backups
*.exe~
supabase.com/supabase-seed-lumen.ps1

# steam free-license sweep runtime state (progress + local config)
steampowered.com/activated_packages.txt
steampowered.com/skipped_packages.txt
steampowered.com/config.json.local
steampowered.com/sweep.log

# browser profiles must never be staged
**/edge-profile/
**/.session/

# mirror-all.ps1 / to-mega.ps1 backup output (5+ GB, never commit repo history bundles)
github.com/mirror/

# reddit web-session cookie export (auth material, never commit)
reddit.com/.reddit-session.json

