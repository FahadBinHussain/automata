# Root-level ignores (safe defaults)

# OS/editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.tmp
*.log

# Env and local config
.env
.env.*
*.local
**/.env.local
youtube.com/youtube.com-stream-watch-codex-automation.config.json

# Build artifacts (embeds machine build paths - rebuild from source)
tools/socks5-proxy/*.exe
tools/window-capture/*.exe

# Dependency folders
**/node_modules/
**/.pnpm-store/

# Python caches/venvs
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc

# Build/cache outputs
**/dist/
**/build/
**/.cache/
**/.next/
**/.nuxt/
**/coverage/

# IDE folders
.vscode/
.idea/
tools/agents-sync/last-sync-content.txt
tools/agents-sync/last-popup.txt
tools/agents-sync/agent-rules-sync.ps1.bak-20260615

# tool build backups
*.exe~
supabase.com/supabase-seed-lumen.ps1

# f95zone session cookies
**/.session/
